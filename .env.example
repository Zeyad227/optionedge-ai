# OptionEdge AI — copy to .env and fill in values you have.
# Missing keys disable that provider; the app still boots on keyless sources.

# --- Required for options greeks / IV / history ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=indicative

# --- Macro / economic calendar ---
FRED_API_KEY=

# --- News + company profiles ---
FINNHUB_API_KEY=

# --- Fallback option chains (sandbox; no greeks) ---
TRADIER_SANDBOX_TOKEN=

# --- Equity quote backups ---
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- SEC EDGAR (caller identification, not a secret) ---
# SEC requires a real name + reachable email or it will throttle/block you.
SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"

# --- App ---
# SQLite + memory cache: zero infra required.
# Docker Postgres: postgresql+asyncpg://optionedge:optionedge@localhost:5432/optionedge
# Docker Redis:     CACHE_BACKEND=redis and REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite+aiosqlite:///./data/optionedge.db
REDIS_URL=
CACHE_BACKEND=memory
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
SCANNER_UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,JPM,XOM
REFRESH_INTERVAL_SECONDS=60
DISCLAIMER_ENABLED=true
WORKERS_ENABLED=true
WARM_CACHE_ON_STARTUP=true
IV_BACKFILL_DAYS_PER_RUN=20
INSIDER_ENRICH_LIMIT=5

# Rate-limit reminders (see README data-sources table):
# - Alpha Vantage: 25/day — never hot path
# - Twelve Data: ~800/day
# - Finnhub: ~60/min
# - Alpaca historical: ~200/min
# - SEC EDGAR: ~10/sec + descriptive User-Agent
